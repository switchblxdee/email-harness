# Комментарии в .gitignore — только на отдельной строке (после шаблона они ломают правило).

# --- Секреты и личные настройки ---
# ключи API и пароли (шаблон .env.example остаётся в git)
.env
# твой конфиг с адресом почты (шаблоны config.example.toml и examples/*.toml остаются в git)
/config.toml

# --- Данные почты: письма коллег, вложения, история ответов ---
# бэклог, вложения, dry-run ответы, песочница
/data/
# состояние харнесса (кому и когда отвечали) и служебные файлы SQLite (-journal, -wal, -shm)
*.sqlite3
*.sqlite3-*
# письма, выгруженные из почты для `try` (тестовые в examples/emails/ остаются в git)
/*.eml
# логи (nohup ... >> harness.log): в них темы и адреса писем
*.log

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Системное ---
.DS_Store
